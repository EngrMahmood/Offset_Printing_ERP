# Env vars for the CLOUD deployment (docker-compose / Oracle VM).
# The Windows LAN server does not use this file and is unaffected by it —
# it sets none of these, so it keeps using the hardcoded defaults in
# Offset_ERP/settings.py exactly as before.

# --- Django ---
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DJANGO_DEBUG=False
ALLOWED_HOSTS=yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# --- Database ---
# Default is SQLite (same engine as the Windows server), stored on a Docker
# volume via SQLITE_PATH (already set in docker-compose.yml, no need to
# repeat it here). Fine for a closed system with ~15-20 users.
#
# To switch to Postgres instead, uncomment DATABASE_URL below and add a
# postgres `db` service back to docker-compose.yml:
# DATABASE_URL=postgres://offset_erp:change-me@db:5432/offset_erp

# --- Redis is provided by the `redis` container automatically; only override
#     REDIS_URL here if using an external instance (e.g. Upstash). ---
# REDIS_URL=redis://default:password@your-upstash-host:port

# --- Email (optional, same as the Windows server; can also be set from the
#     Settings -> Roles & Access Control UI instead) ---
# GMAIL_ADDRESS=you@gmail.com
# GMAIL_APP_PASSWORD=app-password-here

# --- Backups ---
# Tags this instance's backup filenames (e.g. ERP_Backup_sqlite_v...._CloudVM_....zip)
# so they're distinguishable when multiple servers sync to the same Drive/OneDrive.
BACKUP_INSTANCE_LABEL=CloudVM

# The Backup Settings fields below live in db.sqlite3 -- which gets wholesale
# overwritten by scripts/cloud/sync_db_to_cloud.bat every time production
# data is pushed here, silently reverting this deployment's backup routing
# back to whatever the syncing machine had configured (Windows paths that
# don't exist on Linux). These overrides always win over the DB value, so
# they survive every sync:
BACKUP_LOCAL_FOLDER_OVERRIDE=backups
BACKUP_ONEDRIVE_FOLDER_OVERRIDE=onedrive:ERP_Backups/CloudVM
BACKUP_GDRIVE_FOLDER_OVERRIDE=gdrive:ERP_Backups/CloudVM
BACKUP_INCLUDE_MEDIA_OVERRIDE=True
BACKUP_MEDIA_FOLDER_OVERRIDE=gdrive:ERP_Backups/CloudVM/Media
